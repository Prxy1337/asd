local MainRemote = ReplicatedStorage
	:WaitForChild("Packages")
	:WaitForChild("Knit")
	:WaitForChild("Services")
	:WaitForChild("RemotesService")
	:WaitForChild("RE")
	:WaitForChild("MainRemote")

-- =====================================================
-- 🔁 AUTO FARM
-- =====================================================
task.spawn(function()
	while true do
		if farming then
			if #POSITIONS == 0 then
				POSITIONS = scanSpawners()
			end
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local target = getNearest(hrp.Position)
				if target then
					smoothWalkTo(target)
					task.wait(STAND_DELAY)
				end
			end
		end
		task.wait(0.05)
	end
end)

