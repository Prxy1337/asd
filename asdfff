}

local BOSS = {
	["0hxsn"] = true,
	["Connor"] = true,
	["Ghoulax"] = true
}

local activeMobs = {}
local mobIndex = {}

local function getMobTargets(mobName)
	local results = {}
	local folder = workspace.__GAME_CONTENT.Mobs.Halloween
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and model.Name == mobName then
			local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
			if part then table.insert(results, part) end
		end
	end
	return results
end

task.spawn(function()
	while true do
		for mobName, enabled in pairs(activeMobs) do
			if enabled then
				local targets = getMobTargets(mobName)
				if #targets > 0 then
					mobIndex[mobName] = (mobIndex[mobName] or 0) + 1
					if mobIndex[mobName] > #targets then mobIndex[mobName] = 1 end
					local target = targets[BOSS[mobName] and 1 or mobIndex[mobName]]
					local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					if hrp and target then
						hrp.CFrame = target.CFrame * CFrame.new(0,0,-4)
					end
				end
				task.wait(BOSS[mobName] and 0.6 or 0.35)
			end
		end
		task.wait(0.15)
	end
end)

for _, mob in ipairs(HALLOWEEN_MOBS) do
	HalloweenSection:Toggle("TP: "..mob.label, function(v)
		activeMobs[mob.key] = v
	end)
end

