local BOSS = {["0hxsn"]=true,["Connor"]=true,["Ghoulax"]=true}
local activeMobs = {}
local mobIndex = {}

local function getMobTargets(mobName)
	local results = {}
	local folder = workspace:WaitForChild("__GAME_CONTENT")
		:WaitForChild("Mobs")
		:WaitForChild("Halloween")

	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and model.Name == mobName then
			local part = model:FindFirstChild("HumanoidRootPart") 
				or model:FindFirstChildWhichIsA("BasePart")
			if part then
				table.insert(results, part)
			end
		end
	end
	return results
end

task.spawn(function()
	while true do
		for mobName, enabled in pairs(activeMobs) do
			if enabled then
				local targets = getMobTargets(mobName)
				if #targets > 0 then
					mobIndex[mobName] = (mobIndex[mobName] or 0) + 1
					if mobIndex[mobName] > #targets then
						mobIndex[mobName] = 1
					end
					local target = targets[BOSS[mobName] and 1 or mobIndex[mobName]]
					local char = player.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if hrp and target then
						hrp.CFrame = target.CFrame * CFrame.new(0,0,-4)
					end
				end
				task.wait(BOSS[mobName] and 0.05 or 0.05)
			end
		end
		task.wait(0.05)
	end
end)

