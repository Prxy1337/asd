local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

getgenv().EVENT_SCRIPT_RUNNING = true

-- =====================================================
-- ⚙️ SETTINGS
-- =====================================================
local WALK_SPEED = 120
local WALK_TIMEOUT = 0.15
local STAND_DELAY = 0.25

-- =====================================================
-- 📦 SCAN SHARDS SPAWNERS
-- =====================================================
local function scanSpawners()
    local positions = {}
    local folder = workspace:WaitForChild("__GAME_CONTENT"):WaitForChild("ShardsSpawners")
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("BasePart") then
            table.insert(positions, obj.Position)
        end
    end
    return positions
end

local POSITIONS = scanSpawners()

local function getNearest(pos)
    local idx, dist = nil, math.huge
    for i, p in ipairs(POSITIONS) do
        local d = (p - pos).Magnitude
        if d < dist then
            dist = d
            idx = i
        end
    end
    if idx then
        return table.remove(POSITIONS, idx)
    end
end

-- =====================================================
-- 🧱 NOCLIP
-- =====================================================
local noclipConn
local function enableNoclip()
    noclipConn = RunService.Stepped:Connect(function()
        if not getgenv().EVENT_SCRIPT_RUNNING then return end
        local char = player.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end)
end

local function disableNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
end

-- =====================================================
-- 🔁 STATES
-- =====================================================
local farming = false
local upgrading = false
local originalSpeed = 16

-- =====================================================
-- 🚶‍♂️ AUTO SHARDS FARM LOOP
-- =====================================================
task.spawn(function()
    while getgenv().EVENT_SCRIPT_RUNNING do
        if farming then
            if #POSITIONS == 0 then
                POSITIONS = scanSpawners()
            end

            local char = player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hum and hrp then
                local target = getNearest(hrp.Position)
                if target then
                    hum:MoveTo(target)
                    task.wait(WALK_TIMEOUT)
                    task.wait(STAND_DELAY)
                end
            end
        end
        task.wait(0.05)
    end
end)

-- =====================================================
-- 🔼 EVENT SHARDS UPGRADE LOOP
-- =====================================================
local UpgradeRemote = ReplicatedStorage
    :WaitForChild("Packages")
    :WaitForChild("Knit")
    :WaitForChild("Services")
    :WaitForChild("RemotesService")
    :WaitForChild("RE")
    :WaitForChild("MainRemote")

local UpgradeList = {
    "Event Shards 2",
    "Event Luck",
    "Event Bulk",
    "Event Crystals",
    "Event Crystal Chance"
}

task.spawn(function()
    while getgenv().EVENT_SCRIPT_RUNNING do
        if upgrading then
            for _, up in ipairs(UpgradeList) do
                if not upgrading or not getgenv().EVENT_SCRIPT_RUNNING then break end
                pcall(function()
                    UpgradeRemote:FireServer("Upgrade", "Event Shards", up)
                end)
                task.wait(0.35)
            end
        end
        task.wait(0.2)
    end
end)

