-- 🔁 STATES
-- =====================================================
local farming = false
local upgrading = false
local originalSpeed = 16

-- =====================================================
-- 🚶‍♂️ AUTO SHARDS FARM LOOP
-- =====================================================
task.spawn(function()
    while getgenv().EVENT_SCRIPT_RUNNING do
        if farming then
            if #POSITIONS == 0 then
                POSITIONS = scanSpawners()
            end

            local char = player.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hum and hrp then
                local target = getNearest(hrp.Position)
                if target then
                    hum:MoveTo(target)
                    task.wait(WALK_TIMEOUT)
                    task.wait(STAND_DELAY)
                end
            end
        end
        task.wait(0.05)
    end
end)

