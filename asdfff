-- 📦 SHARDS SPAWNERS (500k FARM)
-- =====================================================
local function scanSpawners()
	local positions = {}
	local content = workspace:WaitForChild("__GAME_CONTENT")
	local folder = content:WaitForChild("ShardsSpawners")

	for _, obj in ipairs(folder:GetDescendants()) do
		if obj:IsA("BasePart") then
			table.insert(positions, obj.Position)
		end
	end
	return positions
end

local POSITIONS = scanSpawners()

local function getNearest(pos)
	local index, dist = nil, math.huge
	for i, p in ipairs(POSITIONS) do
		local d = (p - pos).Magnitude
		if d < dist then
			dist = d
			index = i
		end
	end
	if index then
		return table.remove(POSITIONS, index)
	end
end

-- =====================================================
-- 🧱 NOCLIP
-- =====================================================
local noclipConn
local function enableNoclip()
	noclipConn = RunService.Stepped:Connect(function()
		local char = player.Character
		if not char then return end
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
	end)
end

local function disableNoclip()
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
end

-- =====================================================
-- 🚶 SMOOTH WALK FARM
-- =====================================================
local function smoothWalkTo(targetPos)
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	while (hrp.Position - targetPos).Magnitude > 2 do
		local dir = (targetPos - hrp.Position).Unit
		hrp.CFrame = hrp.CFrame + dir * WALK_SPEED * task.wait()
	end
end

-- =====================================================
-- 🔁 AUTO FARM 500k
-- =====================================================
task.spawn(function()
	while true do
		if farming then
			if #POSITIONS == 0 then
				POSITIONS = scanSpawners()
			end
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local target = getNearest(hrp.Position)
				if target then
					smoothWalkTo(target)
					task.wait(STAND_DELAY)
				end
			end
		end
		task.wait(0.05)
	end
end)

