-- Event Toggles
eventTab:Toggle("Auto Shards Farm", false, function(state)
    farming = state
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then
        if state then
            originalSpeed = hum.WalkSpeed
            hum.WalkSpeed = WALK_SPEED
            enableNoclip()
        else
            hum.WalkSpeed = originalSpeed
            disableNoclip()
        end
    end
end)

eventTab:Toggle("Auto Upgrade Event Shards", false, function(state)
    upgrading = state
end)

