local function getMobTargets(mobName)
	local results = {}
	local folder = workspace:WaitForChild("__GAME_CONTENT"):WaitForChild("Mobs"):WaitForChild("Halloween")
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") and model.Name == mobName then
			local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
			if part then table.insert(results, part) end
		end
	end
	return results
end

-- Mob teleport loop
