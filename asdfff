local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- =====================================================
-- ⚙️ EINSTELLUNGEN
-- =====================================================
local WALK_SPEED = 120
local WALK_TIMEOUT = 0.15
local STAND_DELAY = 0.25

-- =====================================================
-- 📦 SPAWNER SCANNEN (SHARDS)
-- =====================================================
local function scanSpawners()
	local positions = {}
	local content = workspace:WaitForChild("__GAME_CONTENT")
	local folder = content:WaitForChild("ShardsSpawners")

	for _, obj in ipairs(folder:GetDescendants()) do
		if obj:IsA("BasePart") then
			table.insert(positions, obj.Position)
		end
	end

	print("💎 Shards Spawner gefunden:", #positions)
	return positions
end

local POSITIONS = scanSpawners()

-- =====================================================
-- 🔍 NÄCHSTER SPAWNER
-- =====================================================
local function getNearestSpawner(pos)
	local nearestIndex
	local shortest = math.huge

	for i, spawnerPos in ipairs(POSITIONS) do
		local dist = (spawnerPos - pos).Magnitude
		if dist < shortest then
			shortest = dist
			nearestIndex = i
		end
	end

	if nearestIndex then
		return table.remove(POSITIONS, nearestIndex)
	end
end

-- =====================================================
-- 🧱 NOCLIP
-- =====================================================
local noclipConn
local function enableNoclip()
	noclipConn = RunService.Stepped:Connect(function()
		local char = player.Character
		if not char then return end
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
	end)
end

local function disableNoclip()
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
end

-- =====================================================
-- 🔁 STATUS
-- =====================================================
local running = false
local originalSpeed = 16

-- =====================================================
-- 🚶‍♂️ FARM LOOP (dauerhaft, reagiert auf Toggle)
-- =====================================================
task.spawn(function()
	while true do
		if running then
			if #POSITIONS == 0 then
				POSITIONS = scanSpawners()
			end

			local char = player.Character or player.CharacterAdded:Wait()
			local hum = char:WaitForChild("Humanoid")
			local hrp = char:WaitForChild("HumanoidRootPart")

			local target = getNearestSpawner(hrp.Position)
			if target then
				hum:MoveTo(target)

				local reached = false
				local conn
				conn = hum.MoveToFinished:Connect(function()
					reached = true
					conn:Disconnect()
				end)

				local start = tick()
				while not reached and tick() - start < WALK_TIMEOUT and running do
					task.wait(0.05)
				end

				task.wait(STAND_DELAY)
			end
		end
		task.wait(0.05)
	end
end)













